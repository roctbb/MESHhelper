# Web
WEB_PORT=8787

# Telegram (optional; obtain your own application credentials at my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional SOCKS5 route when the server cannot reach Telegram directly.
# Like school-crm: socks5h://user:password@host:1080 (socks5:// also supported)
TELEGRAM_PROXY_URL=
# auto: WSS via proxy, TCP without proxy. Override with tcp or wss if needed.
TELEGRAM_TRANSPORT=auto
# Base delay plus a fresh random addition per message. NOT a safe anti-spam quota.
TELEGRAM_SEND_INTERVAL_MS=5000
TELEGRAM_SEND_JITTER_MS=5000
# Defaults to .telegram-data next to web-service.js; never put inside web/.
TELEGRAM_DATA_DIR=
# Optional 32-byte base64 encryption key. If absent, generated in TELEGRAM_DATA_DIR/key.
TELEGRAM_SESSION_KEY=

# API paging/limits (used by frontend calculations)
API_ACADEMIC_YEAR_ID=14
API_SCHOOL_ID=0
# Optional override for analytics source (class teacher mode, comma-separated)
API_CLASS_UNIT_IDS=
API_GROUPS_PER_PAGE=300
API_MARKS_PER_PAGE=300
API_ATTENDANCES_PER_PAGE=1000
API_INCLUDE_ATTENDANCES=true

# Default headers for API proxy (can be overridden from UI)
API_ROLE_ID=9
API_HOST_ID=9
API_SUBSYSTEM=journalsw

# Academic range for analytics requests
EXPORT_START_AT=2026-09-01
EXPORT_STOP_AT=2027-08-31

# Trimester boundaries
TRIMESTER_1_LABEL=1 триместр
TRIMESTER_1_START=2026-09-01
TRIMESTER_1_END=2026-11-30
TRIMESTER_2_LABEL=2 триместр
TRIMESTER_2_START=2026-12-01
TRIMESTER_2_END=2027-02-28
TRIMESTER_3_LABEL=3 триместр
TRIMESTER_3_START=2027-03-01
TRIMESTER_3_END=2027-05-23
