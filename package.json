{
  "name": "mesh-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "MESH web assistant: analytics and marks workflow via API proxy",
  "main": "web-service.js",
  "scripts": {
    "start": "node web-service.js",
    "dev:api": "node --watch web-service.js",
    "dev:web": "vite",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-default-type=module --test tests/*.test.mjs",
    "check": "node --check web-service.js"
  },
  "dependencies": {
    "big-integer": "1.6.52",
    "dotenv": "^16.6.1",
    "socks-proxy-agent": "10.1.0",
    "teleproto": "1.229.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "vite": "^5.4.10"
  }
}
